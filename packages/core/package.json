{
  "name": "@pagescope/core",
  "version": "0.1.0",
  "description": "Audit the technical and SEO quality of a single web page without a browser.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devalfian/website-auditor.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/devalfian/website-auditor#readme",
  "bugs": {
    "url": "https://github.com/devalfian/website-auditor/issues"
  },
  "keywords": [
    "seo",
    "audit",
    "html",
    "accessibility",
    "static-analysis",
    "ci"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "parse5": "8.1.0",
    "undici": "8.12.3",
    "zod": "4.6.7"
  }
}
