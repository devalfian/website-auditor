  "license": "MIT",
  "bin": {
    "pagescope": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devalfian/website-auditor.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/devalfian/website-auditor#readme",
  "bugs": {
    "url": "https://github.com/devalfian/website-auditor/issues"
  },
  "keywords": [
    "seo",
    "audit",
    "cli",
    "ci",
    "static-analysis"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pagescope/core": "workspace:*",
    "commander": "15.0.0",
    "zod": "4.6.7"
